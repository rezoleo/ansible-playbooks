{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices"
  ],
  "dependencyDashboard": {
    "enabled": true
  },
  "prHourlyLimit": 3,
  "timezone": "Europe/Paris",
  "osvVulnerabilityAlerts": true,
  "labels": ["dependencies", "{{updateType}}"],
  "pre-commit": {
    "enabled": true
  },
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["roles/nextcloud/defaults/main.yml"],
      "matchStrings": ["nextcloud_version: \"(?<currentValue>.*?)\""],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "nextcloud/server",
      "extractVersionTemplate": "^v(?<version>.*)$"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["roles/garage/defaults/main.yml"],
      "matchStrings": ["garage_version: \"(?<currentValue>.*?)\""],
      "datasourceTemplate": "forgejo-releases",
      "depNameTemplate": "Deuxfleurs/garage",
      "registryUrlTemplate": "https://git.deuxfleurs.fr"
    }
  ],
  "packageRules": [
    {
      "matchPackageNames": ["ansible-lint", "pre-commit", "ruff", "ty"],
      "addLabels": ["development"]
    },
    {
      "description": "Debian 13 (trixie) ships Python 3.13",
      "matchManagers": ["mise", "pep621", "pyenv"],
      "matchDepNames": ["python"],
      "allowedVersions": "<3.14"
    }
  ],
  "vulnerabilityAlerts": {
    "labels": ["security", "{{vulnerabilitySeverity}}"],
    "enabled": true
  }
}
