{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices"
  ],
  "dependencyDashboard": true,
  "prHourlyLimit": 3,
  "timezone": "Europe/Paris",
  "osvVulnerabilityAlerts": true,
  "labels": ["dependencies", "{{updateType}}"],
  "pre-commit": {
    "enabled": true
  },
  "packageRules": [
    {
      "matchPackageNames": ["ansible-lint", "pre-commit", "ruff", "ty"],
      "addLabels": ["development"]
    },
    {
      "description": "Debian 13 (trixie) ships Python 3.13",
      "matchManagers": ["mise", "pep621"],
      "matchDepNames": ["python"],
      "allowedVersions": "<3.14"
    }
  ],
  "vulnerabilityAlerts": {
    "labels": ["security", "{{vulnerabilitySeverity}}"],
    "enabled": true
  }
}
