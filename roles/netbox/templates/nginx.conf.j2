# {{ ansible_managed }}
server {
    listen 80;
    listen [::]:80;
    server_name {{ netbox_hostname }};
    return 301 https://{{ netbox_hostname }}$request_uri;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name {{ netbox_hostname }};
    ssl_certificate /var/lib/vault_agent_certificates/cert.pem;
    ssl_certificate_key /var/lib/vault_agent_certificates/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    client_max_body_size 25m;

    location /static/ {
        alias {{ netbox_directory }}/netbox/static/;
    }

    location / {
        proxy_pass http://127.0.0.1:8001;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;
    }
}
