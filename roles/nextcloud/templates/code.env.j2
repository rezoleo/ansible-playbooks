# CODE (Collabora Online)
# see https://sdk.collaboraonline.com/docs/installation/CODE_Docker_image.html

# WOPI host (Nextcloud) allowed to use this Collabora instance
aliasgroup1=https://{{ nextcloud_host }}:443
# Public hostname of Collabora, as seen through the reverse proxy
server_name={{ nextcloud_code_host }}
DONT_GEN_SSL_CERT=true
# TLS is terminated by the reverse proxy
extra_params=--o:ssl.enable=false --o:ssl.termination=true
