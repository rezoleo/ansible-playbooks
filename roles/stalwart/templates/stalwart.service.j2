[Unit]
Description=Stalwart mail server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=stalwart
Group=stalwart
EnvironmentFile={{ stalwart_config_path }}/stalwart.env
ExecStart=/usr/local/bin/stalwart --config {{ stalwart_config_path }}/config.json
Restart=on-failure
LimitNOFILE=65536
AmbientCapabilities=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true

[Install]
WantedBy=multi-user.target
