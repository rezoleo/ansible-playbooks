[Unit]
Description=Stalwart hook: copies mail sent as a group into its Sent Items
After=stalwart.service

[Service]
ExecStart=/usr/local/bin/stalwart-group-sent-hook
EnvironmentFile={{ stalwart_config_path }}/group-sent-hook.env
DynamicUser=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes
Restart=on-failure

[Install]
WantedBy=multi-user.target
