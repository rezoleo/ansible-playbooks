#jinja2: variable_start_string:'[[', variable_end_string:']]', block_start_string:'[%', block_end_string:'%]'
{{- with pkiCert "[[ vault_agent_pki_mount ]]/issue/[[ vault_agent_pki_role ]]" "common_name=[[ vault_agent_fqdn ]]" "ip_sans=[[ vault_agent_ip_sans | join(',') ]]" [% if vault_agent_extra_dns_sans | length > 0 %]"alt_names=[[ vault_agent_extra_dns_sans | join(',') ]]" [% endif %]"ttl=[[ vault_agent_cert_ttl ]]" -}}
{{ .Cert }}
{{ .CA }}
{{ .Key | writeToFile "[[ vault_agent_host_cert_dir ]]/[[ vault_agent_privkey_filename ]]" "root" "[[ vault_agent_host_cert_group ]]" "0640" "newline" }}
{{- end -}}
